---
// The paper's abstract, on the research page, in place.
//
// This is what replaced the per-project page. A reader who wants the detail
// should not have to load a second address to get it, and the summary above it
// is doing a different job: the summary says what the work is, the abstract
// says what the paper claims.
//
// It is a <details>, which is a disclosure a keyboard can reach and a screen
// reader announces the state of without a line of script, so the first paint is
// already correct and nothing has to run for it to work.
//
// It starts closed. The summary above it is what a reader is deciding on, and
// four full abstracts between four projects is a wall of technical prose in the
// middle of that decision. The control says what opening it gives you, so
// nobody opens it to find out.
import { clean } from '../lib/canonical';

interface Props {
  text: string;
  /** `paper` is the published abstract; `summary` was written from the repo */
  kind?: 'paper' | 'summary';
  /** what the quoted abstract does not say about the scope of the work */
  note?: string;
  class?: string;
}
const { text, kind = 'summary', note, class: cls = '' } = Astro.props;
const word = kind === 'paper' ? 'Full abstract' : 'About the paper';
---

<details class:list={['abs', cls]}>
  <summary class="abs__sum">
    <span class="abs__word">{word}</span>
    <svg class="abs__chev" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
      <path
        d="M2.4 4.3 6 7.9l3.6-3.6"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </summary>
  <p class="abs__body">{clean(text)}</p>
  {/* The paper's own words stop at the paragraph above. Anything the site has
      to say about what the work did not do is set apart from them, so a reader
      can see where the quotation ends. */}
  {note && <p class="abs__note">{clean(note)}</p>}
</details>

<style>
  .abs {
    border-top: 1px solid var(--rule);
    padding-top: var(--sp-3);
  }
  .abs__sum {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    cursor: pointer;
    list-style: none;
    font-size: var(--fs-small);
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--ink-3);
    /* A summary is a button in everything but name, so it gets a button's
       target rather than the height of one word. */
    padding-block: 0.25em;
    transition: color var(--dur-lift-out) var(--ease-out);
  }
  .abs__sum::-webkit-details-marker {
    display: none;
  }
  .abs__sum:hover,
  .abs__sum:focus-visible {
    color: var(--orange-ink);
  }
  .abs__chev {
    width: 0.7em;
    height: 0.7em;
    transition: transform var(--dur-lift) var(--ease-out);
  }
  .abs[open] .abs__chev {
    transform: rotate(-180deg);
  }
  .abs__body {
    margin-top: var(--sp-2);
    /* The abstract is quoted source text, so it keeps whatever punctuation the
       paper used, including the dashes the rest of the site does without. */
    max-width: var(--measure);
    color: var(--ink-2);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .abs__note {
    margin-top: var(--sp-3);
    padding-top: var(--sp-3);
    border-top: 1px solid var(--rule);
    max-width: var(--measure);
    font-size: var(--fs-small);
    line-height: 1.55;
    color: var(--ink-3);
    text-wrap: pretty;
  }

  @media (prefers-reduced-motion: reduce) {
    .abs__chev {
      transition: none;
    }
  }
</style>
