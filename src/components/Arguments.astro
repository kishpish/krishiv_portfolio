---
// The last section of the home page: stated positions rather than activities.
// An ordered list of opinions, so it is an <ol>; the claim carries the weight
// and the defence under it is quieter and factual. No cards, no icons, no
// second column, and four items rather than five, because the last section of
// a page should not be its heaviest.
import { data, clean } from '../lib/canonical';

const args = data.arguments;
const email = data.person.email;
const subject = encodeURIComponent('You are wrong about one of these');
---

<section class="wrap section section--last" aria-labelledby="arguing">
  <div class="section__head">
    <p class="eyebrow">Positions, not hobbies</p>
    <h2 id="arguing">Things I will argue about</h2>
    <p>
      {clean(args.intro)}{' '}
      <a href={`mailto:${email}?subject=${subject}`}>{email}</a>
    </p>
  </div>
  <ol class="args">
    {
      args.items.map((a) => (
        <li class="args__item">
          <p class="args__claim">{clean(a.claim)}</p>
          <p class="args__def">{clean(a.defense)}</p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .args {
    list-style: none;
    padding: 0;
    max-width: var(--measure);
    counter-reset: arg;
  }
  .args__item {
    counter-increment: arg;
    padding-block: var(--sp-4);
    border-top: 1px solid var(--rule);
  }
  .args__item:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .args__claim {
    display: flex;
    gap: 0.7em;
    font-weight: 700;
    line-height: 1.4;
    text-wrap: pretty;
  }
  .args__claim::before {
    content: counter(arg) '.';
    flex: none;
    color: var(--ink-4);
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }
  .args__def {
    margin-top: var(--sp-2);
    padding-left: 1.5em;
    font-size: var(--fs-small);
    line-height: 1.55;
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .section--last {
    padding-bottom: var(--sp-7);
  }
</style>
