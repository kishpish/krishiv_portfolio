---
// Everything that goes in <head>: title, description, canonical, Open Graph,
// Twitter cards, feeds, font preloads, and optional JSON-LD.
import { data, clean } from '../lib/canonical';
import { url, absolute } from '../lib/urls';
import lato400 from '../assets/fonts/lato-400.woff2?url';
import lato700 from '../assets/fonts/lato-700.woff2?url';
import mono400 from '../assets/fonts/commit-mono-400.woff2?url';

interface Props {
  title?: string;
  description?: string;
  /** key for the generated OG image: /og/<key>.png */
  og?: string;
  type?: 'website' | 'article' | 'profile';
  jsonLd?: object | object[];
  noindex?: boolean;
}

const { title, description = clean(data.site.description), og = 'default', type = 'website', jsonLd, noindex = false } = Astro.props;
const fullTitle = title ? `${title} · ${data.person.name}` : `${data.person.name}`;
const canonical = absolute(Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/');
const ogImage = absolute(`/og/${og}.png`);
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
{/* A noindex page (the 404) declares no canonical and no og:url: both would
    point at an address that does not serve it. */}
{!noindex && <link rel="canonical" href={canonical} />}
{noindex && <meta name="robots" content="noindex, follow" />}
<meta name="author" content={data.person.name} />
<meta name="theme-color" content="#fbfaf6" />
<meta name="color-scheme" content="light" />

<link rel="preload" href={lato400} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={lato700} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={mono400} as="font" type="font/woff2" crossorigin />

<link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
<link rel="icon" href={url('/favicon.png')} type="image/png" sizes="64x64" />
<link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
<link rel="alternate" type="application/rss+xml" title={`${data.person.name}: writing`} href={url('/rss.xml')} />
<link rel="sitemap" href={url('/sitemap-index.xml')} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={data.person.name} />
<meta property="og:title" content={title ?? data.person.name} />
<meta property="og:description" content={description} />
{!noindex && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title ?? data.person.name} />
<meta property="og:locale" content="en_US" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title ?? data.person.name} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
