---
// The thing that flies across the screen when you land on a page.
//
// It is a fixed overlay that clips its own contents, so whatever the glyph does
// it can never widen the document or shift a line of text. It takes no pointer
// events and is hidden from assistive technology, because it carries no
// information: the page is complete and usable without it, on the first frame.
//
// The glyph is drawn here and the motion lives in src/scripts/mascot.ts, which
// gives each object a trajectory that suits it rather than one slide reused
// five times. Under prefers-reduced-motion the script never runs and this
// element stays empty of movement.
interface Props {
  /** which object flies. Omit on a page that should get nothing. */
  kind?: 'wave' | 'computer' | 'notepad' | 'baseball';
}
const { kind } = Astro.props;
---

{
  kind && (
    <div class="mascot" data-mascot={kind} aria-hidden="true">
      <div class="mascot__g" data-mascot-glyph>
        {kind === 'wave' && (
          /* The site saying hello and then getting out of the way. Two glyphs
             stacked in one box: the hand waves, then the motion carries through
             a crossfade into the plane, which flies off. They are separate
             layers because a hand and a dart have nothing in common to morph
             between, and faking a matched path would distort both. */
          <>
            <span class="mascot__layer mascot__layer--hand" data-mascot-layer="hand">
              <svg viewBox="0 0 24 24" class="mascot__svg">
                <path
                  d="M9.1 12.9V7.1a1.4 1.4 0 0 1 2.8 0v4V4.9a1.4 1.4 0 0 1 2.8 0v6.2V6.5a1.4 1.4 0 0 1 2.8 0v8.3c0 3.7-2.2 6.5-5.4 6.5-3 0-5-1.8-5.8-4.4L4.6 14a1.4 1.4 0 0 1 2.3-1.5z"
                  fill="var(--card)"
                  stroke="var(--ink)"
                  stroke-width="1.5"
                  stroke-linejoin="round"
                  stroke-linecap="round"
                />
              </svg>
            </span>
            <span class="mascot__layer mascot__layer--plane" data-mascot-layer="plane">
              <svg viewBox="0 0 24 24" class="mascot__svg">
                {/* The far wing, catching the light. */}
                <path
                  d="M22 10.2 3.4 3.3a.5.5 0 0 0-.65.64l3.6 8 3 1.2z"
                  fill="var(--card)"
                  stroke="var(--ink)"
                  stroke-width="1.5"
                  stroke-linejoin="round"
                  stroke-linecap="round"
                />
                {/* The near wing, turned away from it. */}
                <path
                  d="M22 10.2 9.35 13.14l-.5 6.6a.5.5 0 0 0 .9.33l3.1-5.1z"
                  fill="var(--paper-2)"
                  stroke="var(--ink)"
                  stroke-width="1.5"
                  stroke-linejoin="round"
                  stroke-linecap="round"
                />
                {/* The centre crease. Without it a dart is just a triangle. */}
                <path d="M6.35 11.94 22 10.2" fill="none" stroke="var(--ink)" stroke-width="1.3" stroke-linecap="round" />
              </svg>
            </span>
          </>
        )}

        {kind === 'computer' && (
          <svg viewBox="0 0 24 24" class="mascot__svg">
            <rect x="2.2" y="3.6" width="19.6" height="13.2" rx="1.8" fill="var(--card)" stroke="var(--ink)" stroke-width="1.5" />
            <rect x="4.4" y="5.8" width="15.2" height="8.8" rx="0.6" fill="var(--blue)" opacity="0.2" />
            <path d="M8.6 20.4h6.8" stroke="var(--ink)" stroke-width="1.5" stroke-linecap="round" />
            <path d="M12 16.8v3.6" stroke="var(--ink)" stroke-width="1.5" stroke-linecap="round" />
          </svg>
        )}

        {kind === 'notepad' && (
          <svg viewBox="0 0 24 24" class="mascot__svg">
            <path
              d="M4.5 2.8h10.2l5 5v13.4a1 1 0 0 1-1 1h-14.2a1 1 0 0 1-1-1V3.8a1 1 0 0 1 1-1z"
              fill="var(--card)"
              stroke="var(--ink)"
              stroke-width="1.5"
              stroke-linejoin="round"
            />
            {/* the folded corner, which is what makes a rectangle read as paper */}
            <path d="M14.7 2.8v5h5" fill="none" stroke="var(--ink)" stroke-width="1.5" stroke-linejoin="round" />
            <path
              d="M7.6 12.4h8.8M7.6 15.4h8.8M7.6 18.4h5.4"
              stroke="var(--ink-4)"
              stroke-width="1.4"
              stroke-linecap="round"
            />
          </svg>
        )}

        {kind === 'baseball' && (
          <svg viewBox="0 0 24 24" class="mascot__svg">
            <circle cx="12" cy="12" r="9.4" fill="#fbf8f0" stroke="var(--ink-3)" stroke-width="1.1" />
            {/* The two seams are what make a circle a baseball, and they are
                what the eye tracks once the thing starts spinning. */}
            <path d="M5.1 5.7c2.6 2.4 2.6 10.2 0 12.6" fill="none" stroke="#c2392e" stroke-width="1.5" stroke-linecap="round" />
            <path d="M18.9 5.7c-2.6 2.4-2.6 10.2 0 12.6" fill="none" stroke="#c2392e" stroke-width="1.5" stroke-linecap="round" />
            <path
              d="M4.0 8.1l2.2.5M3.6 10.6l2.3.2M3.6 13.4l2.3-.2M4.0 15.9l2.2-.5M20.0 8.1l-2.2.5M20.4 10.6l-2.3.2M20.4 13.4l-2.3-.2M20.0 15.9l-2.2-.5"
              stroke="#c2392e"
              stroke-width="1.1"
              stroke-linecap="round"
            />
          </svg>
        )}
      </div>
    </div>
  )
}

<style>
  /* Fixed and clipping, so a glyph parked off the right edge mid-flight cannot
     extend the scroll width the way an absolutely positioned one would. */
  .mascot {
    position: fixed;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 60;
    contain: strict;
  }
  .mascot__g {
    position: absolute;
    top: 0;
    left: 0;
    width: 2.6rem;
    height: 2.6rem;
    /* Parked off-screen until the script picks it up, so a reader with no
       JavaScript never sees a stray glyph in the corner. */
    opacity: 0;
    will-change: transform, opacity;
  }
  .mascot__svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  /* A layered mascot animates its layers, not the box around them, so the box
     has to stop carrying the opacity that hides a single-glyph one. Each layer
     still starts at zero, so a reader with no JavaScript sees nothing either
     way. */
  .mascot__g:has(.mascot__layer) {
    opacity: 1;
  }
  /* Both glyphs occupy the same box, so the plane inherits the hand's exact
     position at the moment of the handoff and the motion never breaks. */
  .mascot__layer {
    position: absolute;
    inset: 0;
    display: block;
    opacity: 0;
    will-change: transform, opacity;
  }
  /* A hand waves from the wrist. Rotating about the centre of the glyph looks
     like a hand being twisted, so the origin sits at the base of the palm and
     the fingers swing through the wide end of the arc. */
  .mascot__layer--hand {
    transform-origin: 50% 88%;
  }
  .mascot__layer--plane {
    transform-origin: 50% 50%;
  }
  @media (max-width: 36rem) {
    .mascot__g {
      width: 2.1rem;
      height: 2.1rem;
    }
  }

  /* Nothing flies. The element stays in the tree so the script can find it and
     decide not to run, and nothing here ever animates. */
  @media (prefers-reduced-motion: reduce) {
    .mascot {
      display: none !important;
    }
  }
</style>
