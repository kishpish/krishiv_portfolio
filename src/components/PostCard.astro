---
// A note on the writing index and the tag pages. The card itself is the link,
// the same way the home-page previews work, so the whole surface is the hit
// area and there is nothing nested inside it to tab through.
//
// The tags sit outside the card for exactly that reason: a link inside a link
// is invalid, and burying the tag links would also take them out of the tab
// order on the one page where filtering by tag is the point.
import type { CollectionEntry } from 'astro:content';
import { url } from '../lib/urls';
import { readingMinutes, tagSlug } from '../lib/posts';

interface Props {
  post: CollectionEntry<'posts'>;
  showSection?: boolean;
  /** heading level for the card title, so pages keep a correct outline */
  level?: 2 | 3;
}
const { post, showSection = false, level = 3 } = Astro.props;
const H = `h${level}` as 'h2' | 'h3';
const d = post.data;
const minutes = readingMinutes(post.body);
---

<article class="pcard-wrap" data-reveal>
  <a class="card pcard" href={url(`/writing/${post.id}/`)}>
    <H class="pcard__title">
      <span>{d.title}</span>
      {d.status === 'in progress' && <span class="badge badge--in-progress pcard__status">In progress</span>}
    </H>
    <p class="pcard__desc">{d.description}</p>
    <p class="pcard__meta meta">
      {showSection && <span>{d.section}</span>}
      <span>{minutes} min</span>
    </p>
  </a>
  {
    d.tags.length > 0 && (
      <p class="pcard__tags">
        {d.tags.map((t) => (
          <a href={url(`/writing/tags/${tagSlug(t)}/`)}>{t}</a>
        ))}
      </p>
    )
  }
</article>

<style>
  .pcard-wrap {
    max-width: var(--measure);
  }
  .pcard {
    display: block;
    padding: var(--sp-5);
  }
  .pcard__title {
    font-size: var(--fs-h3);
    font-weight: 700;
    line-height: 1.3;
    color: var(--ink);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5em;
    text-wrap: pretty;
  }
  .pcard:hover .pcard__title,
  .pcard:focus-visible .pcard__title {
    color: var(--blue-ink);
  }
  .pcard__desc {
    margin-top: var(--sp-2);
    color: var(--ink-2);
    line-height: 1.55;
    text-wrap: pretty;
  }
  .pcard__meta {
    margin-top: var(--sp-3);
    color: var(--ink-4);
  }
  .pcard__status {
    font-size: var(--fs-small);
    font-weight: 400;
  }
  /* Outside the card, quieter than it, and still real links. */
  .pcard__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3em 0.9em;
    margin-top: var(--sp-2);
    padding-inline: var(--sp-2);
    font-size: var(--fs-small);
  }
  .pcard__tags a {
    color: var(--ink-4);
  }
  .pcard__tags a:hover,
  .pcard__tags a:focus-visible {
    color: var(--orange-ink);
  }
</style>
