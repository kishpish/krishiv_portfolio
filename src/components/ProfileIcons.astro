---
// The external profile links as a row of marks.
//
// Every glyph is inline SVG on a 24 unit grid and every one is a filled path,
// so the set reads as one family rather than a mix of stroked and solid marks.
// They are defined here once and nowhere else.
//
// Each link carries a visible-to-assistive-tech name rather than an aria-label,
// because a real text node survives translation and an attribute does not. The
// hit area is held at 44px regardless of how small the glyph is drawn, which is
// the smallest target a thumb can reliably find.
import { data } from '../lib/canonical';

interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
const p = data.person;

// Brand marks are the official single-path forms. The envelope is drawn here,
// solid like the rest, because a stroked mail icon in a row of filled logos is
// the one shape that would look borrowed.
const PATHS: Record<string, string> = {
  email:
    'M1.5 6.75A1.5 1.5 0 0 1 3 5.25h18a1.5 1.5 0 0 1 1.5 1.5v.43l-10.11 6.07a.75.75 0 0 1-.78 0L1.5 7.18zm0 2.18v8.32A1.5 1.5 0 0 0 3 18.75h18a1.5 1.5 0 0 0 1.5-1.5V8.93l-9.34 5.6a2.25 2.25 0 0 1-2.32 0z',
  github:
    'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12',
  linkedin:
    'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0z',
  orcid:
    'M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.369 4.378a.947.947 0 1 1 0 1.894.947.947 0 0 1 0-1.894zm-.722 3.038h1.444v10.041H6.647zm3.562 0h3.9c3.712 0 5.344 2.653 5.344 5.025 0 2.578-2.016 5.025-5.325 5.025h-3.919zm1.444 1.303v7.444h2.297c2.359 0 3.588-1.444 3.588-3.722 0-2.016-1.088-3.722-3.722-3.722z',
  scholar: 'M5.242 13.769 0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5s-5.548 1.749-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14z',
  x: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z',
};

// Scholar and X are rendered only once a handle exists, the same way the rest
// of the site treats an unset profile.
const items = [
  { key: 'email', name: 'Email', href: `mailto:${p.email}` },
  { key: 'github', name: 'GitHub', href: p.profiles.github },
  { key: 'linkedin', name: 'LinkedIn', href: p.profiles.linkedin },
  { key: 'orcid', name: 'ORCID', href: p.profiles.orcid },
  ...(p.profiles.scholar ? [{ key: 'scholar', name: 'Google Scholar', href: p.profiles.scholar }] : []),
  ...(p.profiles.x ? [{ key: 'x', name: 'X', href: p.profiles.x }] : []),
];
---

<ul class:list={['picons', cls]}>
  {
    items.map((i) => (
      <li>
        <a
          class="picons__a"
          href={i.href}
          rel={i.href.startsWith('mailto:') ? undefined : 'noopener'}
        >
          <svg class="picons__g" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path fill="currentColor" d={PATHS[i.key]} />
          </svg>
          <span class="visually-hidden">{i.name}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .picons {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    padding: 0;
    /* Negative inline start so the first glyph optically aligns with the label
       above it, since each link carries its own padding to reach 44px. */
    margin-inline-start: calc(var(--picon-pad) * -1);
  }
  .picons__a {
    --picon-pad: 0.6rem;
    display: grid;
    place-items: center;
    /* 44px of target whatever the glyph measures, which is the smallest a thumb
       finds reliably. The glyph itself stays small so the row reads as type. */
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: var(--picon-pad);
    color: var(--ink-3);
    border-radius: var(--card-radius);
    text-decoration: none;
    transition:
      color var(--dur-lift-out) var(--ease-out),
      transform var(--dur-lift-out) var(--ease-out);
  }
  .picons__g {
    width: 1.15rem;
    height: 1.15rem;
    display: block;
  }
  .picons__a:hover,
  .picons__a:focus-visible {
    color: var(--orange-ink);
    /* A glyph has no underline to thicken and no box to lift, so the whole mark
       rises by a fraction of the card lift. It is the same gesture, scaled to
       the size of the thing making it. */
    transform: translateY(calc(var(--lift) / 3));
    transition-duration: var(--dur-lift);
  }
  @media (prefers-reduced-motion: reduce) {
    .picons__a:hover,
    .picons__a:focus-visible {
      transform: none;
    }
  }
</style>
