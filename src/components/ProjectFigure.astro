---
// The one generated figure left on the site, wrapped as a numbered paper figure
// with an italic caption.
//
// Every other project now shows the figure from its own paper instead, which is
// what a reader came for. This one stays because the funnel is a view of the
// pipeline's own search, not a result that exists as a published panel.
import Tem171Funnel from './figures/Tem171Funnel.astro';

interface Props {
  id: string;
  caption: string;
  alt: string;
  n?: string;
  class?: string;
}
const { id, caption, alt, n = '1', class: cls = '' } = Astro.props;
const map: Record<string, any> = {
  'tem171-funnel': Tem171Funnel,
};
const Fig = map[id];
if (!Fig) throw new Error(`Unknown figure id "${id}". Add it to src/components/ProjectFigure.astro.`);
---

<figure class:list={['projfig', cls]}>
  <div class="projfig__frame">
    <Fig />
    <span class="visually-hidden">{alt}</span>
  </div>
  <figcaption class="fig__caption">
    <span class="fig__n">Fig. {n}</span>{caption}
  </figcaption>
</figure>

<style>
  .projfig {
    margin: 0;
  }
  .projfig__frame {
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--paper);
    padding: var(--sp-3);
    overflow: hidden;
  }
  @media (max-width: 30rem) {
    .projfig__frame {
      padding: var(--sp-2);
    }
  }
</style>
