---
// A research card: figure first where there is one, then the venue badge, the
// paper's own title, the authors, a technical description, the evidence, and
// every link the paper has. The publication metadata is read from
// canonical.yaml, so a project and its paper are never out of step.
import type { CollectionEntry } from 'astro:content';
import { url } from '../lib/urls';
import { data, publication, statusLabel, clean, sentence } from '../lib/canonical';
import Evidence from './Evidence.astro';
import ProjectFigure from './ProjectFigure.astro';
import ProjectMedia from './ProjectMedia.astro';

interface Props {
  entry: CollectionEntry<'research'>;
  n: number;
  compact?: boolean;
  /** give the card a stable id, so /research/#<id> lands on it */
  anchor?: boolean;
  /** heading level for the card title, so each page keeps a correct outline */
  level?: 2 | 3;
}
const { entry, n, compact = false, level = 3, anchor = false } = Astro.props;
const H = `h${level}` as 'h2' | 'h3';
const d = entry.data;
const pub = d.paper ? publication(d.paper) : null;
const href = url(`/research/${entry.id}/`);
// The paper's own title, not the project file's short label. Projects without a
// paper yet fall back to their working title.
const heading = pub ? clean(pub.title) : d.title;
const authorHtml = (a: string[]) =>
  a.map((n) => (n === data.person.name ? `<strong>${n}</strong>` : n)).join(', ');
---

<article class:list={['rcard', compact && 'rcard--compact']} id={anchor ? entry.id : undefined} data-reveal>
  <div class="rcard__index tnum" aria-hidden="true">{String(n).padStart(2, '0')}</div>

  <div class="rcard__body">
    <p class="rcard__badges">
      {pub && <span class:list={['badge', 'badge--venue']}>{pub.venue}</span>}
      {pub && <span class:list={['badge', `badge--${pub.status}`]}>{statusLabel[pub.status]}</span>}
      {!pub && d.status && <span class="badge badge--in-progress">{sentence(d.status)}</span>}
      {d.honor && <span class="badge badge--honor">{d.honor}</span>}
    </p>

    <H class="rcard__title">
      <a href={href}>{heading}</a>
    </H>

    {pub && <p class="rcard__authors" set:html={authorHtml(pub.authors)} />}

    <p class="rcard__q">{clean(d.summary)}</p>

    {!compact && d.evidence.length > 0 && <Evidence items={d.evidence} size="sm" class="rcard__ev" />}

    <p class="rcard__meta meta">
      <span>{d.role}</span>
      <span>{d.period}</span>
      {pub && <span>{pub.venue_long}</span>}
      {pub && <span class="tnum">{pub.year}</span>}
    </p>

    {
      (pub?.links.length || d.links.length || pub?.doi) && (
        <p class="links rcard__links">
          {(pub ? pub.links : d.links).map((l) => (
            <a href={l.href} rel="noopener">{l.label}</a>
          ))}
          {pub?.doi && <a href={`https://doi.org/${pub.doi}`} rel="noopener">doi</a>}
          <a href={href}>project page</a>
        </p>
      )
    }
  </div>

  {
    !compact && (d.media || d.figure) && (
      <div class="rcard__fig">
        {d.media ? (
          <ProjectMedia
            src={d.media.src}
            poster={d.media.poster}
            caption={clean(d.media.caption)}
            alt={clean(d.media.alt)}
            n={String(n)}
          />
        ) : (
          <ProjectFigure id={d.figure!.id} caption={clean(d.figure!.caption)} alt={clean(d.figure!.alt)} n={String(n)} />
        )}

        {/* Further panels from the paper, where one picture does not carry the
            work on its own. */}
        {d.gallery.length > 0 && (
          <div class="rcard__gallery">
            {d.gallery.map((g) => (
              <figure class="rcard__gitem card">
                <picture>
                  <source srcset={url(`${g.src}.webp`)} type="image/webp" />
                  <img
                    src={url(`${g.src}.${g.fallback}`)}
                    alt={clean(g.alt)}
                    width={g.width}
                    height={g.height}
                    loading="lazy"
                    decoding="async"
                  />
                </picture>
              </figure>
            ))}
          </div>
        )}
      </div>
    )
  }
</article>

<style>
  .rcard {
    display: grid;
    grid-template-columns: 2.6rem minmax(0, 1fr);
    gap: var(--sp-2) var(--sp-4);
    padding-block: var(--sp-6);
    border-top: 1px solid var(--rule);
  }
  /* On a wide screen the figure sits beside the text, which is how a paper
     would set it and keeps the card from running down the page. */
  @media (min-width: 72rem) {
    .rcard:not(.rcard--compact):has(.rcard__fig) {
      grid-template-columns: 2.6rem minmax(0, 1fr) minmax(0, 1.08fr);
      column-gap: var(--sp-6);
    }
    .rcard:not(.rcard--compact):has(.rcard__fig) .rcard__fig {
      grid-column: 3;
      grid-row: 1;
      margin-top: 0;
      max-width: none;
    }
  }
  .rcard__index {
    font-size: var(--fs-small);
    color: var(--ink-4);
    padding-top: 0.35em;
    font-variant-numeric: tabular-nums;
  }
  .rcard__body {
    max-width: var(--measure);
  }
  .rcard__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em;
    margin-bottom: var(--sp-3);
  }
  .rcard__title {
    font-size: var(--fs-h3);
    font-weight: 700;
    line-height: 1.25;
  }
  .rcard__title a {
    color: var(--ink);
  }
  .rcard__title a:hover,
  .rcard__title a:focus-visible {
    color: var(--orange);
  }
  .rcard__authors {
    margin-top: var(--sp-2);
    font-size: var(--fs-small);
    color: var(--ink-2);
  }
  .rcard__links {
    margin-top: var(--sp-3);
  }
  .rcard__q {
    margin-top: var(--sp-3);
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .rcard__ev {
    margin-top: var(--sp-5);
  }
  .rcard__meta {
    margin-top: var(--sp-4);
  }
  .rcard__fig {
    grid-column: 2;
    margin-top: var(--sp-5);
    max-width: 44rem;
  }
  /* A project figure sits on the same raised surface as a preview card, but it
     does not rise under the cursor the way one does: there is nothing here to
     click, and lifting it would say otherwise. What it does instead is let the
     picture inside grow a little, which reads as an invitation to look rather
     than an invitation to click. */
  .rcard__fig :global(figure) {
    border-radius: var(--card-radius);
    overflow: hidden;
    background: var(--card);
    box-shadow: var(--shadow-1);
  }
  .rcard__fig :global(figcaption) {
    padding: 0 var(--sp-4) var(--sp-4);
  }
  /* Anchored sections need room under the sticky header when linked to. */
  .rcard[id] {
    scroll-margin-top: var(--sp-6);
  }
  .rcard__gallery {
    margin-top: var(--sp-4);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: var(--sp-3);
  }
  .rcard__gitem {
    margin: 0;
    overflow: hidden;
    line-height: 0;
  }
  .rcard__gitem :global(img) {
    width: 100%;
    height: 100%;
    aspect-ratio: 2 / 1;
    object-fit: cover;
    display: block;
    transition: transform var(--dur-lift-out) var(--ease-out);
  }
  .rcard__gitem:hover :global(img) {
    transform: scale(var(--media-zoom));
    transition-duration: var(--dur-lift);
  }
  @media (prefers-reduced-motion: reduce) {
    .rcard__gitem :global(img) {
      transform: none !important;
    }
  }
  .rcard--compact {
    padding-block: var(--sp-4);
  }

  @media (max-width: 36rem) {
    .rcard {
      grid-template-columns: 1fr;
      gap: var(--sp-2);
      padding-block: var(--sp-5);
    }
    .rcard__index {
      padding-top: 0;
    }
    .rcard__fig {
      grid-column: 1;
      margin-top: var(--sp-4);
    }
  }
</style>
