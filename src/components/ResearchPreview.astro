---
// A home-page research preview: the picture and the name, nothing else.
//
// The whole card is a single link to that project's section on the research
// page, so there is no nested-link problem and the entire surface is the hit
// area. Everything a reader might otherwise want here (venue, status, authors,
// summary, links) is one click away on the page this points at.
import type { CollectionEntry } from 'astro:content';
import { url } from '../lib/urls';
import { publication, statusLabel, clean, sentence } from '../lib/canonical';

interface Props {
  entry: CollectionEntry<'research'>;
}
const { entry } = Astro.props;
const d = entry.data;
const pub = d.paper ? publication(d.paper) : null;
const heading = pub ? clean(pub.title) : d.title;
// One quiet marker under the title: the venue for published work, the status
// for work that has none yet.
const marker = pub ? pub.venue : d.status ? sentence(d.status) : null;
const markerStatus = pub ? statusLabel[pub.status] : null;

// Projects carry either a still (`thumb`) or a video whose poster frame we use
// here. A row of three autoplaying videos is not worth the bytes on a preview;
// the video itself still plays on the research page.
const thumb = d.thumb;
const poster = d.media?.poster;
const fit = thumb?.fit ?? 'contain';
---

<a class="card rpre" href={url(`/research/#${entry.id}`)} data-reveal>
  <span class:list={['rpre__media', `rpre__media--${fit}`]}>
    {
      thumb ? (
        <picture>
          <source srcset={url(`${thumb.src}.webp`)} type="image/webp" />
          <img
            src={url(`${thumb.src}.${thumb.fallback}`)}
            alt={clean(thumb.alt)}
            width={thumb.width}
            height={thumb.height}
            loading="lazy"
            decoding="async"
          />
        </picture>
      ) : poster ? (
        <img
          src={url(poster)}
          alt={d.media ? clean(d.media.alt) : ''}
          width="440"
          height="440"
          loading="lazy"
          decoding="async"
        />
      ) : null
    }
  </span>
  <span class="rpre__body">
    <span class="rpre__title">{heading}</span>
    {
      marker && (
        <span class="rpre__marker">
          <span class="rpre__venue">{marker}</span>
          {markerStatus && <span class="rpre__status">{markerStatus}</span>}
        </span>
      )
    }
  </span>
</a>

<style>
  .rpre {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    height: 100%;
  }
  /* The figure is a window cut into the card, not a panel laid on top of it.
     Insetting it means the board shows on all four sides and there is no seam
     left to colour-match, which is what the old hard-edged plate and its 1px
     rule under it were doing. ProjectMedia and ProjectFigure already set a
     figure in a --paper window inside a --card panel on the research page; this
     card was the one surface ignoring that convention.

     3:2 frames a paper figure better than 4:3 did, and it is close enough to the
     real aspect of all three that nothing is badly letterboxed. */
  .rpre__media {
    position: relative;
    display: block;
    margin: var(--sp-3) var(--sp-3) 0;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: var(--radius);
    /* The window is the page showing through the cut. It is also the value the
       figure below is multiplied onto, so one token does both jobs. */
    background: var(--paper);
    /* Without a stacking context the multiply reaches past the window to the
       board and the page, and neither position nor overflow opens one. */
    isolation: isolate;
  }
  /* The cut edge and the shade inside it, on a pseudo-element because an inset
     shadow paints below replaced content and the image fills the window. */
  .rpre__media::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow:
      inset 0 0 0 1px var(--rule),
      inset 0 2px 3px -1px var(--window-shade);
    pointer-events: none;
    transition: box-shadow var(--dur-lift-out) var(--ease-out);
  }
  /* The window sinks as the board rises, which is what a cut in a board does
     when it comes up toward the light. The hairline steps one rung on the rule
     ramp rather than warming, because only the card's outer ring carries the
     accent and the window should not compete with it. Colour rather than
     transform, so a reader on reduced motion still gets an answer here. */
  .rpre:hover .rpre__media::after,
  .rpre:focus-visible .rpre__media::after {
    box-shadow:
      inset 0 0 0 1px var(--rule-2),
      inset 0 3px 6px -1px var(--window-shade-deep);
    transition-duration: var(--dur-edge);
  }
  /* Absolute, so a child's intrinsic size can never stretch the window: a
     440 square poster and a 900 by 627 figure get the same box. */
  .rpre__media :global(picture),
  .rpre__media :global(img) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }
  /* The media is the part that scales on hover. Doing it here rather than on
     the card keeps every piece of text rendering at its natural size. */
  .rpre__media :global(img) {
    transition: transform var(--dur-lift-out) var(--ease-out);
    /* Stated at rest so leaving reads the zero from here and the whole card
       arrives home together. */
    transition-delay: 0s;
  }
  /* A plot ships a white canvas, and white on a warm window is a visible
     rectangle however warm the window is. Multiply removes it rather than
     matching it: white times the window is the window exactly, and black cannot
     move because anything times zero is zero. The same idiom, with the same
     reasoning, is already in ProjectMedia. */
  .rpre__media--contain :global(img) {
    object-fit: contain;
    padding: var(--sp-3);
    mix-blend-mode: multiply;
  }
  /* A figure carrying its own background must not be multiplied or its darks get
     pushed further down, which is exactly what fit: cover already marks. */
  .rpre__media--cover :global(img) {
    object-fit: cover;
  }
  /* The third beat. The board is already moving before the figure starts to
     open, which is what stops the lift and the zoom reading as one event. The
     delay is on the way in only. */
  .rpre:hover .rpre__media :global(img),
  .rpre:focus-visible .rpre__media :global(img) {
    transform: scale(var(--media-zoom));
    transition-duration: var(--dur-lift);
    transition-delay: var(--delay-media);
  }

  .rpre__body {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    /* The side padding matches the board around the window, so the title aligns
       to the figure's own left edge and the board reads as one continuous
       margin rather than two different insets. */
    padding: var(--sp-4) var(--sp-3) var(--sp-5);
    /* Three titles of different lengths otherwise leave the row ragged. */
    min-height: 7.25rem;
  }
  .rpre__title {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
    font-size: var(--fs-body);
    font-weight: 700;
    line-height: 1.3;
    color: var(--ink);
    text-wrap: pretty;
  }
  .rpre:hover .rpre__title,
  .rpre:focus-visible .rpre__title {
    color: var(--blue-ink);
  }
  /* Quiet at rest, legible on hover. One more layer without more clutter. */
  .rpre__marker {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5em;
    font-size: var(--fs-small);
    color: var(--ink-4);
    transition: color var(--dur-lift-out) var(--ease-out);
  }
  .rpre:hover .rpre__marker,
  .rpre:focus-visible .rpre__marker {
    color: var(--ink-2);
    transition-duration: var(--dur-lift);
  }
  .rpre__venue {
    font-family: var(--mono);
    font-variant-numeric: tabular-nums;
  }
  .rpre__status::before {
    content: '·';
    margin-right: 0.5em;
  }

  /* The component carries its own guard as well as the global one, because this
     is the only place on the site with a transition-delay to clear. :global() is
     correct here, inside an Astro component style block, which is exactly what
     made the same construct invalid in the plain stylesheet. */
  @media (prefers-reduced-motion: reduce) {
    .rpre__media :global(img) {
      transform: none !important;
      transition-delay: 0s !important;
    }
  }
</style>
