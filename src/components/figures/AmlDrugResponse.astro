---
// Beat AML: deconvolved state abundance vs ex vivo drug response.
// Data: src/data/figures/aml-drug-response.json, from the project repository.
import raw from '../../data/figures/aml-drug-response.json';
import { linear, fmt, PALETTE } from '../../lib/figures/plot';

const W = 560;
const H = 464;
const m = { t: 14, r: 16, b: 70, l: 54 };
const iw = W - m.l - m.r;
const ih = H - m.t - m.b;

const pts = raw.points as { id: string; t: number; v: number; g: string; n: number; ty: string; q: number }[];
const xs = pts.map((p) => p.t);
const ys = pts.map((p) => p.v);
const pad = 0.06;
const x = linear([Math.min(...xs) - pad, Math.max(...xs) + pad], [m.l, m.l + iw]);
const y = linear([Math.min(...ys) - pad, Math.max(...ys) + pad], [m.t + ih, m.t]);

// Lineage groups, in the legend order that makes the split readable.
const groups = [
  { key: 'monocytic/DC', label: 'monocytic, DC', color: PALETTE.orange, shape: 'circle' },
  { key: 'primitive', label: 'primitive, progenitor', color: PALETTE.blue, shape: 'circle' },
  { key: 'erythroid', label: 'erythroid', color: '#4a7f3f', shape: 'triangle' },
  { key: 'lymphoid', label: 'lymphoid', color: PALETTE.ink3, shape: 'square' },
];
const groupOf = (g: string) => groups.find((x) => x.key === g) ?? groups[3];

// Legend x-offsets from the label widths, so entries cannot overlap.
let acc = 0;
const legendX = groups.map((g) => {
  const x = acc;
  acc += 26 + g.label.length * 6.1;
  return x;
});

const r = (n: number) => 3.1 + Math.min(4.1, Math.log10(Math.max(10, n)) * 1.5);

// The three states worth naming.
const callouts: Record<string, { label: string; dx: number; dy: number; anchor: string }> = {
  A0_L1_8: { label: 'cDC-like', dx: 7, dy: -7, anchor: 'start' },
  A0_L1_2: { label: 'Mono-like', dx: -8, dy: -7, anchor: 'end' },
  A2_L1_4: { label: 'Prog-like', dx: 8, dy: 12, anchor: 'start' },
};

function mark(p: (typeof pts)[number]) {
  const g = groupOf(p.g);
  const cx = x(p.t);
  const cy = y(p.v);
  const rr = r(p.n);
  if (g.shape === 'square') return `<rect x="${(cx - rr * 0.82).toFixed(1)}" y="${(cy - rr * 0.82).toFixed(1)}" width="${(rr * 1.64).toFixed(1)}" height="${(rr * 1.64).toFixed(1)}"/>`;
  if (g.shape === 'triangle') {
    const a = rr * 1.15;
    return `<path d="M${cx.toFixed(1)} ${(cy - a).toFixed(1)}L${(cx + a * 0.92).toFixed(1)} ${(cy + a * 0.72).toFixed(1)}L${(cx - a * 0.92).toFixed(1)} ${(cy + a * 0.72).toFixed(1)}Z"/>`;
  }
  return `<circle cx="${cx.toFixed(1)}" cy="${cy.toFixed(1)}" r="${rr.toFixed(1)}"/>`;
}
---

<svg class="fig-svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Scatter plot of cell states by their correlation with MEK inhibitor and venetoclax response.">
  <!-- quadrant reference lines at zero -->
  <g stroke={PALETTE.rule} stroke-width="1" stroke-dasharray="2 3">
    <line x1={x(0)} x2={x(0)} y1={m.t} y2={m.t + ih} />
    <line x1={m.l} x2={m.l + iw} y1={y(0)} y2={y(0)} />
  </g>

  <!-- axes -->
  <g stroke={PALETTE.ink3} stroke-width="1" fill="none">
    <path d={`M${m.l} ${m.t} L${m.l} ${m.t + ih} L${m.l + iw} ${m.t + ih}`} />
    {x.ticks(5).map((t) => <path d={`M${x(t)} ${m.t + ih} l0 4`} />)}
    {y.ticks(5).map((t) => <path d={`M${m.l} ${y(t)} l-4 0`} />)}
  </g>
  <g class="fig-tick" fill={PALETTE.ink3}>
    {x.ticks(5).map((t) => <text x={x(t)} y={m.t + ih + 16} text-anchor="middle">{fmt(t, 1)}</text>)}
    {y.ticks(5).map((t) => <text x={m.l - 8} y={y(t) + 3.5} text-anchor="end">{fmt(t, 1)}</text>)}
  </g>

  <!-- axis titles -->
  <text class="fig-axis" x={m.l + iw / 2} y={m.t + ih + 32} text-anchor="middle" fill={PALETTE.ink2}>
    ρ with MEK inhibitor response  →  resistant
  </text>
  <text class="fig-axis" transform={`translate(13 ${m.t + ih / 2}) rotate(-90)`} text-anchor="middle" fill={PALETTE.ink2}>
    ρ with venetoclax response  →  resistant
  </text>

  <!-- points -->
  {
    groups.map((g) => (
      <g fill={g.color} fill-opacity="0.72" stroke={g.color} stroke-width="0.8">
        <Fragment set:html={pts.filter((p) => groupOf(p.g).key === g.key).map(mark).join('')} />
      </g>
    ))
  }

  <!-- callouts -->
  {
    pts
      .filter((p) => callouts[p.id])
      .map((p) => {
        const c = callouts[p.id];
        return (
          <g>
            <circle cx={x(p.t)} cy={y(p.v)} r={r(p.n) + 3} fill="none" stroke={PALETTE.ink} stroke-width="0.9" />
            <text
              class="fig-call"
              x={x(p.t) + c.dx}
              y={y(p.v) + c.dy}
              text-anchor={c.anchor}
              fill={PALETTE.ink}
            >
              {c.label}
            </text>
          </g>
        );
      })
  }

  <!-- legend, below the plot so it can never collide with a point or callout -->
  <g class="fig-legend" transform={`translate(${m.l} ${H - 14})`}>
    {
      groups.map((g, i) => (
        <g transform={`translate(${legendX[i]} 0)`}>
          <circle cx="4" cy="-3.5" r="4" fill={g.color} fill-opacity="0.72" stroke={g.color} stroke-width="0.8" />
          <text x="13" y="0" fill={PALETTE.ink2}>{g.label}</text>
        </g>
      ))
    }
  </g>
</svg>

<style is:global>
  .fig-svg {
    width: 100%;
    height: auto;
    display: block;
    background: var(--paper);
  }
  .fig-svg text {
    font-family: var(--mono);
    font-variant-numeric: tabular-nums;
  }
  .fig-svg .fig-tick {
    font-size: 10px;
  }
  .fig-svg .fig-axis {
    font-size: 10.5px;
  }
  .fig-svg .fig-call {
    font-size: 10.5px;
    paint-order: stroke;
    stroke: var(--paper);
    stroke-width: 3px;
  }
  .fig-svg .fig-legend text {
    font-size: 10px;
  }
  .fig-svg .fig-label {
    font-size: 10px;
  }
</style>
