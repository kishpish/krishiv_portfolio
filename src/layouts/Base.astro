---
import { ClientRouter } from 'astro:transitions';
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  og?: string;
  type?: 'website' | 'article' | 'profile';
  jsonLd?: object | object[];
  noindex?: boolean;
  class?: string;
}
const { class: cls, ...head } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head {...head} />
    <!-- Cross-document view transitions, so moving between pages is continuous
         rather than a reload. The header and footer persist across the swap so
         they do not flash. -->
    <ClientRouter />
    <!-- for a page that needs one extra tag, such as the retired
         /publications/ address and its refresh -->
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header transition:persist />
    <main id="main" class={cls}>
      <slot />
    </main>
    <Footer transition:persist />
    <script>
      // Landscape interaction plus the scroll reveal, both re-run after a
      // client-side navigation.
      import '../scripts/enhance';
    </script>
  </body>
</html>
