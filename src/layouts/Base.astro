---
import { ClientRouter } from 'astro:transitions';
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Mascot from '../components/Mascot.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  og?: string;
  type?: 'website' | 'article' | 'profile';
  jsonLd?: object | object[];
  noindex?: boolean;
  class?: string;
  /** the object that flies across on arrival. Omit for a page that gets none. */
  mascot?: 'wave' | 'computer' | 'notepad' | 'baseball';
}
const { class: cls, mascot, ...head } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head {...head} />
    <!-- Cross-document view transitions, so moving between pages is continuous
         rather than a reload. The header and footer persist across the swap so
         they do not flash. -->
    <ClientRouter />
    <!-- for a page that needs one extra tag, such as the retired
         /publications/ address and its refresh -->
    <slot name="head" />
    <!-- The theme, before the first paint. This has to be inline, synchronous
         and in the head: a module would resolve after the browser has already
         painted a cream page, which is a white flash for anyone who chose dark.
         It writes the attribute only, never a style, so there is nothing here
         to keep in step with the stylesheet. `data-astro-rerun` because the
         router does re-execute head scripts on a client-side navigation and
         this one must win again if the document was swapped. -->
    <script is:inline data-astro-rerun>
      (function () {
        try {
          var v = localStorage.getItem('theme');
          if (v === 'dark' || v === 'cvd') document.documentElement.setAttribute('data-theme', v);
        } catch (e) {
          /* private mode or blocked storage: no attribute is the cream default,
             which is what :root already is */
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Mascot kind={mascot} />
    <Header transition:persist />
    <main id="main" class={cls}>
      <slot />
    </main>
    <Footer transition:persist />
    <script>
      // Landscape interaction plus the scroll reveal, both re-run after a
      // client-side navigation.
      import '../scripts/enhance';
    </script>
  </body>
</html>
