---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { data, clean, cv } from '../lib/canonical';
import { url, absolute } from '../lib/urls';

const p = data.person;
const ed = p.education;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: p.name,
    url: absolute('/'),
    email: `mailto:${p.email}`,
    description: clean(data.research_statement.short),
    knowsAbout: data.research_statement.interests,
    sameAs: [p.profiles.github, p.profiles.linkedin, p.profiles.orcid, p.profiles.scholar].filter(Boolean),
  },
};
---

<Base
  title="More"
  description="Krishiv Potluri: positions, honors, education, methods and tools, and what happens outside the lab."
  og="about"
  jsonLd={jsonLd}
>
  <div class="wrap">
    <PageHeader eyebrow="More" title="More" />

    <div class="about">
      <div class="about__main">
        <!-- research statement -->
        <section class="abs" aria-labelledby="statement">
          <h2 id="statement">What I work on</h2>
          <div class="prose">
            <p>
              I build models of systems that move, and the infrastructure that makes those
              models checkable. Three things I keep returning to: generative and
              physics-informed models for molecular and material design, energy-based models
              of cell state, and benchmarks that cannot leak.
            </p>
            <p>
              The last of those is the one I would defend hardest. A model that proposes
              something is only worth as much as our ability to tell when it is wrong, and I
              think that second half is undersupplied relative to how much it decides. A good
              deal of what I write is some version of that argument.
            </p>
            <p>
              The projects themselves, with their methods, their numbers, and the parts that
              did not work, are on <a href={url('/research/')}>the research page</a>. The
              positions below are where the work happened.
            </p>
          </div>
        </section>

        <!-- positions -->
        <section class="abs" aria-labelledby="positions">
          <h2 id="positions">Positions</h2>
          <ol class="poslist">
            {
              data.positions.map((pos) => (
                <li class="card">
                  <div class="poslist__head">
                    <p class="poslist__org">
                      {pos.href ? <a href={pos.href} rel="noopener">{pos.org}</a> : pos.org}
                    </p>
                    <p class="poslist__period tnum">{pos.period}</p>
                  </div>
                  <p class="poslist__role">{pos.role}{pos.advisor ? `, with ${pos.advisor}` : ''}</p>
                  <p class="poslist__sum">{clean(pos.summary)}</p>
                </li>
              ))
            }
          </ol>

          <h3 class="abs__sub">Competition</h3>
          <ol class="poslist">
            {
              data.hackathons.map((h) => (
                <li class="card">
                  <div class="poslist__head">
                    <p class="poslist__org">{h.name}</p>
                    <p class="poslist__period tnum">{h.date}</p>
                  </div>
                  <p class="poslist__role">{h.role}, {h.event}</p>
                  <p class="poslist__sum">{clean(h.summary)}</p>
                  <p class="links poslist__links">
                    {h.links.map((l) => <a href={l.href} rel="noopener">{l.label}</a>)}
                  </p>
                </li>
              ))
            }
          </ol>
        </section>

        <!-- honors -->
        <section class="abs" aria-labelledby="honors" id="honors">
          <h2 id="honors-h">Honors</h2>
          <ol class="honors">
            {
              data.honors.map((h) => (
                <li class="card">
                  <span class="honors__y num">{h.year}</span>
                  <span class="honors__b">
                    <span class="honors__t">
                      {h.href ? <a href={h.href} rel="noopener">{h.title}</a> : h.title}
                    </span>
                    <span class="honors__o">{h.org}</span>
                    {h.detail && <span class="honors__d">{h.detail}</span>}
                  </span>
                </li>
              ))
            }
          </ol>
        </section>

        <!-- education -->
        <section class="abs" aria-labelledby="education">
          <h2 id="education">Education</h2>
          <div class="poslist__head">
            <p class="poslist__org">{ed.school}</p>
            <p class="poslist__period tnum">Class of {ed.class_of}</p>
          </div>
          <p class="poslist__role">{ed.place}</p>
          <p class="poslist__sum">
            Coursework beyond what the school offers: {ed.coursework_beyond}. Full
            transcript detail, test scores, and coursework are in the{' '}
            <a href={url(cv.path)}>CV</a>.
          </p>
        </section>

        <!-- beyond -->
        <section class="abs" aria-labelledby="beyond">
          <h2 id="beyond">Beyond the lab</h2>
          <dl class="beyond">
            {
              data.beyond.map((b) => (
                <div class="beyond__item card">
                  <dt>
                    <span class="beyond__label">{b.label}</span>
                    <span class="beyond__title">{b.title}</span>
                  </dt>
                  <dd>{clean(b.body)}</dd>
                </div>
              ))
            }
          </dl>
        </section>
      </div>

      <!-- sidebar -->
      <aside class="about__side">
        <section class="side card">
          <p class="eyebrow">Methods and tools</p>
          <dl class="side__methods">
            {
              data.methods.map((m) => (
                <div>
                  <dt>{m.area}</dt>
                  <dd>{clean(m.items)}</dd>
                </div>
              ))
            }
          </dl>
        </section>
      </aside>
    </div>
  </div>
</Base>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 17rem;
    gap: var(--sp-7);
    align-items: start;
    padding-bottom: var(--sp-6);
  }
  .about__main {
    min-width: 0;
    max-width: var(--measure);
  }
  .abs {
    padding-bottom: var(--sp-7);
  }
  .abs h2 {
    padding-bottom: var(--sp-3);
    border-bottom: 1px solid var(--rule);
    margin-bottom: var(--sp-4);
  }
  .abs__sub {
    margin-top: var(--sp-5);
    margin-bottom: var(--sp-3);
    font-size: var(--fs-body);
  }

  .poslist {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--sp-4);
  }
  .poslist > li {
    padding: var(--sp-4) var(--sp-5);
  }
  .poslist__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--sp-2);
  }
  .poslist__org {
    font-weight: 700;
  }
  .poslist__org a {
    color: var(--ink);
  }
  .poslist__org a:hover,
  .poslist__org a:focus-visible {
    color: var(--orange);
  }
  .poslist__period {
    font-size: var(--fs-small);
    color: var(--ink-3);
    white-space: nowrap;
  }
  .poslist__role {
    font-size: var(--fs-small);
    color: var(--ink-2);
    margin-top: 0.1em;
  }
  .poslist__sum {
    margin-top: var(--sp-2);
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .poslist__links {
    margin-top: var(--sp-2);
  }

  .honors {
    list-style: none;
    padding: 0;
  }
  .honors {
    display: grid;
    gap: var(--sp-3);
  }
  .honors li {
    display: grid;
    grid-template-columns: 4.6rem minmax(0, 1fr);
    gap: var(--sp-3);
    padding: var(--sp-4) var(--sp-5);
  }
  .honors__y {
    font-size: var(--fs-small);
    color: var(--ink-4);
    padding-top: 0.15em;
  }
  .honors__b {
    display: grid;
    gap: 0.1em;
  }
  .honors__t {
    font-weight: 700;
    line-height: 1.35;
  }
  .honors__t a {
    color: var(--ink);
  }
  .honors__t a:hover,
  .honors__t a:focus-visible {
    color: var(--orange);
  }
  .honors__o {
    font-size: var(--fs-small);
    color: var(--ink-3);
  }
  .honors__d {
    font-size: var(--fs-small);
    color: var(--ink-2);
    margin-top: 0.15em;
    text-wrap: pretty;
  }

  .beyond {
    display: grid;
    gap: var(--sp-4);
  }
  .beyond__item {
    padding: var(--sp-4) var(--sp-5);
  }
  .beyond__item dt {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6em;
  }
  .beyond__label {
    font-size: var(--fs-small);
    color: var(--ink-4);
  }
  .beyond__title {
    font-weight: 700;
  }
  .beyond__item dd {
    margin: var(--sp-1) 0 0;
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .about__side {
    position: sticky;
    top: var(--sp-5);
    display: grid;
    gap: var(--sp-5);
  }
  .about__side .side {
    padding: var(--sp-5);
  }
  .side__links,
  .side__methods {
    display: grid;
    gap: var(--sp-3);
    font-size: var(--fs-small);
  }
  .side__methods dt {
    font-weight: 700;
    color: var(--ink);
  }
  .side__methods dd {
    margin: 0.15em 0 0;
    color: var(--ink-3);
    line-height: 1.5;
    text-wrap: pretty;
  }

  @media (max-width: 60rem) {
    .about {
      grid-template-columns: 1fr;
      gap: var(--sp-6);
    }
    .about__side {
      position: static;
      max-width: var(--measure);
    }
  }
</style>
