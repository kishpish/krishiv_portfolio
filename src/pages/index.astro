---
// The home page is previews only. Every section shows its top few items and
// then links to the page that holds the rest, so nothing here is the last word
// on anything. The one exception is the section about me, which is the only
// place the interests and the current work are stated in full.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import EnergyLandscape from '../components/EnergyLandscape.astro';
import PathDivider from '../components/PathDivider.astro';
import ResearchPreview from '../components/ResearchPreview.astro';
import PostPreview from '../components/PostPreview.astro';
import SocialRow from '../components/SocialRow.astro';
import { data, clean } from '../lib/canonical';
import { url, absolute } from '../lib/urls';
import { allPosts } from '../lib/posts';

const p = data.person;
const rs = data.research_statement;
const portrait = data.images.portrait;
const projects = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
const topProjects = projects.slice(0, 3);
const posts = await allPosts();
const featuredPosts = [
  'energy-is-a-modeling-choice',
  'reward-is-a-bad-interface-for-design',
  'benchmarks-decide-what-a-field-discovers',
]
  .map((id) => posts.find((x) => x.id === id))
  .filter(Boolean) as typeof posts;

// Three, inline, with the full list on More.
const featuredHonors = data.honors.filter((h) => h.featured).slice(0, 3);

// Previous positions for the hero, read from the positions list rather than
// written out again here.
const prev = ['Austin Energy', 'Shire Bio']
  .map((org) => data.positions.find((x) => x.org === org))
  .filter(Boolean) as typeof data.positions;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: p.name,
  givenName: p.given_name,
  familyName: p.family_name,
  url: absolute('/'),
  image: absolute(`${portrait.src}.jpg`),
  email: `mailto:${p.email}`,
  description: clean(rs.short),
  knowsAbout: rs.interests,
  address: { '@type': 'PostalAddress', addressLocality: 'Austin', addressRegion: 'TX', addressCountry: 'US' },
  // The hero prints the affiliation as plain text, but the structured data
  // still carries both institutional URLs.
  affiliation: {
    '@type': 'ResearchOrganization',
    name: `${p.affiliation.group}, ${p.affiliation.institute}`,
    url: p.affiliation.institute_url,
    sameAs: p.affiliation.group_url,
    parentOrganization: { '@type': 'CollegeOrUniversity', name: p.affiliation.university },
  },
  alumniOf: { '@type': 'EducationalOrganization', name: p.education.school },
  sameAs: [p.profiles.github, p.profiles.linkedin, p.profiles.orcid, p.profiles.scholar, p.profiles.x].filter(Boolean),
  identifier: { '@type': 'PropertyValue', propertyID: 'ORCID', value: p.profiles.orcid_id },
};
---

<Base description={clean(data.site.description)} og="default" type="profile" jsonLd={jsonLd} mascot="particle">
  <!-- ============================================ hero -->
  <section class="wrap hero" aria-labelledby="hero-name">
    <div class="hero__text">
      <div class="hero__id rise" style="--i:0">
        <picture class="hero__photo">
          <source srcset={url(`${portrait.src}.webp`)} type="image/webp" />
          <img
            src={url(`${portrait.src}.jpg`)}
            alt={portrait.alt}
            width={portrait.width}
            height={portrait.height}
            fetchpriority="high"
            decoding="async"
          />
        </picture>
        <div class="hero__who">
          <h1 id="hero-name" class="hero__name">{p.name}</h1>
          <p class="hero__role">
            Student Researcher, Current @ Computational Visualization Center, UT Austin Oden
            Institute
          </p>
          <p class="hero__prev">
            {prev.map((x) => <span>Prev @ {x.org}</span>)}
          </p>
        </div>
      </div>

      <p class="hero__statement rise" style="--i:2">
        I work at the intersection of machine learning, computational biology, and
        physics-based simulation.
      </p>

      <SocialRow class="hero__social rise" />
    </div>

    <div class="hero__fig rise" style="--i:4">
      <EnergyLandscape
        mode="hero"
        caption={'The Müller-Brown potential: three basins, two saddles, and a dashed minimum-energy path between the two deepest wells. The orange trace is a particle finding the deepest one.'}
        captionMotion={'Move the cursor to apply a local repulsive force.'}
      />
    </div>
  </section>

  <div class="wrap"><PathDivider at={1} mark="B" /></div>

  <!-- ============================================ currently -->
  <section class="wrap section" aria-labelledby="currently">
    <div class="section__head" data-reveal>
      <p class="eyebrow">Currently</p>
      <h2 id="currently">Research interests and current work</h2>
    </div>

    <div class="now" data-reveal>
      <div class="now__main">
        <ul class="now__list">
          {
            data.current_work.map((w) => (
              <li>
                <strong>{clean(w.title)}.</strong> {clean(w.note)}
              </li>
            ))
          }
        </ul>
        <p class="now__where">
          The two port-Hamiltonian projects are at the{' '}
          <a href={p.affiliation.group_url} rel="noopener">
            {p.affiliation.group}
          </a>
          , advised by {p.affiliation.advisor}. The hydrogel work is my own.
        </p>

        <p class="now__honors">
          Recently:{' '}
          {
            featuredHonors.map((h, i) => (
              <>
                {i > 0 && ', '}
                {h.href ? (
                  <a href={h.href} rel="noopener">
                    {h.title}
                  </a>
                ) : (
                  h.title
                )}{' '}
                <span class="tnum muted">{h.year}</span>
              </>
            ))
          }. <a href={url('/about/#honors')}>Honors, positions, and education are on More.</a>
        </p>
      </div>

      <aside class="now__side card">
        <p class="now__int">
          <strong class="now__int-label">{rs.core_label}:</strong>{' '}
          <Fragment set:html={rs.core_html} />
        </p>
        <p class="now__int">
          <strong class="now__int-label">{rs.directions_label}:</strong>{' '}
          <Fragment set:html={rs.directions_html} />
        </p>
      </aside>
    </div>
  </section>

  <div class="wrap"><PathDivider at={0.81} mark="‡" /></div>

  <!-- ============================================ research (preview) -->
  <section class="wrap section" aria-labelledby="research">
    <div class="section__head" data-reveal>
      <h2 id="research">Research</h2>
    </div>
    <div class="prow">
      {topProjects.map((entry) => <ResearchPreview entry={entry} />)}
    </div>
    <p class="section__more" data-reveal>
      <a href={url('/research/')}>All five projects, with the publication list</a>
    </p>
  </section>

  <div class="wrap"><PathDivider at={0.683} mark="C" /></div>

  <!-- ============================================ writing (preview) -->
  <section class="wrap section" aria-labelledby="writing">
    <div class="section__head" data-reveal>
      <h2 id="writing">Writing</h2>
      <p class="section__sub">Reflections &amp; Perspectives</p>
    </div>
    <div class="prow">
      {featuredPosts.map((post) => <PostPreview post={post} />)}
    </div>
    <p class="section__more" data-reveal>
      <a href={url('/writing/')}>All {posts.length} notes, by subject</a>
    </p>
  </section>

  <div class="wrap"><PathDivider at={0.381} mark="‡" /></div>

  <!-- ============================================ me -->
  <section class="wrap section section--last" aria-labelledby="me">
    <div class="section__head" data-reveal>
      <h2 id="me">Me</h2>
    </div>
    <div class="me" data-reveal>
      <p class="me__say card">
        Hi :) When I'm not trying to keep up with the ever-expanding world of AI, you can
        usually find me in the gym pushing 245 on bench, on the baseball field with the boys,
        or running pickup basketball games at the local rec. If I'm not there, I'm probably
        running 2K with LeBron as my main.
      </p>

      <div class="hitme card">
        <p class="hitme__h">Reach Out!</p>
        <p class="hitme__p">to talk AI, fitness, video games, or whatever</p>
        <SocialRow variant="contact" class="hitme__row" />
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- hero
     Two columns: everything about me on the left, the figure on the right,
     with a full gutter between them so the photo never comes near it. The
     photo and the name sit together in a row that survives the collapse. */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.74fr);
    gap: var(--sp-6) var(--sp-8);
    align-items: center;
    padding-block: var(--sp-7) var(--sp-5);
  }
  .hero__id {
    display: flex;
    align-items: center;
    gap: var(--sp-5);
  }
  .hero__photo {
    flex: none;
    display: block;
    /* Modest: an identifier, not a portrait feature. Shrinks before the figure
       does at laptop widths. */
    width: clamp(7.5rem, 11.5vw, 10.25rem);
  }
  .hero__photo :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--card-radius);
    box-shadow: var(--shadow-1);
  }
  .hero__name {
    font-size: var(--fs-name);
    font-weight: 700;
    letter-spacing: -0.028em;
    line-height: 1.0;
  }
  .hero__role {
    /* real space under the name, so the name reads as a title */
    margin-top: var(--sp-4);
    font-size: calc(var(--fs-body) * 1.02);
    color: var(--ink-2);
    max-width: 36ch;
    text-wrap: pretty;
  }
  .hero__prev {
    margin-top: var(--sp-2);
    display: flex;
    flex-wrap: wrap;
    gap: 0.15em 1.1em;
    font-size: var(--fs-small);
    line-height: 1.4;
    color: var(--ink-4);
  }
  .hero__statement {
    margin-top: var(--sp-6);
    max-width: 46ch;
    text-wrap: pretty;
  }
  .hero__social {
    margin-top: var(--sp-5);
  }
  .hero__fig {
    position: sticky;
    top: var(--sp-4);
    max-width: 30rem;
    margin-left: auto;
  }

  /* Below three columns' worth of room the figure drops under the text and
     takes the full width; the photo and name stay together. */
  @media (max-width: 60rem) {
    .hero {
      grid-template-columns: 1fr;
      gap: var(--sp-6);
      padding-block: var(--sp-6) var(--sp-2);
    }
    .hero__fig {
      position: static;
      max-width: 36rem;
      margin-left: 0;
    }
    .hero__role,
    .hero__statement {
      max-width: var(--measure);
    }
  }
  /* On a phone the photo and the name still sit together at the top, but the
     role and the previous positions get the full width instead of squeezing
     into the column beside a photo. */
  @media (max-width: 34rem) {
    .hero__id {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      gap: var(--sp-4);
      align-items: center;
    }
    .hero__who {
      display: contents;
    }
    .hero__name {
      grid-column: 2;
    }
    .hero__role,
    .hero__prev {
      grid-column: 1 / -1;
    }
    .hero__role {
      margin-top: 0;
    }
    .hero__prev {
      gap: 0.15em 0.8em;
    }
  }

  /* ---------- currently */
  .now {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: var(--sp-6);
    align-items: start;
  }
  .now__list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--sp-4);
    max-width: var(--measure);
  }
  .now__list li {
    padding-left: var(--sp-4);
    border-left: 2px solid var(--blue-16);
    text-wrap: pretty;
  }
  .now__where,
  .now__honors {
    margin-top: var(--sp-5);
    font-size: var(--fs-small);
    color: var(--ink-2);
    max-width: var(--measure);
    text-wrap: pretty;
  }
  .now__honors {
    margin-top: var(--sp-4);
    padding-top: var(--sp-4);
    border-top: 1px solid var(--rule);
  }
  /* Research interests, set the way the CV sets them: a bolded lead-in, a
     colon, then running prose. Not a list and not a table. */
  .now__side {
    padding: var(--sp-5);
  }
  .now__int {
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .now__int + .now__int {
    margin-top: var(--sp-4);
  }
  .now__int-label {
    color: var(--ink);
  }
  @media (max-width: 52rem) {
    .now {
      grid-template-columns: 1fr;
      gap: var(--sp-5);
    }
  }

  /* ---------- preview rows: three across, one column on a phone, two on a
     tablet. Research and writing share this exactly. */
  .prow {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-5);
    align-items: stretch;
  }
  @media (max-width: 62rem) {
    .prow {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 40rem) {
    .prow {
      grid-template-columns: 1fr;
    }
  }
  .section__sub {
    margin-top: var(--sp-2) !important;
    font-size: var(--fs-body);
    color: var(--ink-3);
  }
  .section__more {
    margin-top: var(--sp-5);
    font-size: var(--fs-small);
  }
  .section--last {
    padding-bottom: var(--sp-8);
  }

  /* ---------- me */
  .me {
    max-width: var(--measure);
  }
  /* The one casual moment on the page, so it gets room to breathe rather than
     being packed in: larger than body copy, a generous measure, real padding. */
  .me__say {
    padding: var(--sp-6);
    max-width: 58ch;
    font-size: calc(var(--fs-body) * 1.12);
    line-height: 1.65;
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .hitme {
    margin-top: var(--sp-6);
    padding: var(--sp-5);
    max-width: 30rem;
  }
  .hitme__h {
    font-size: var(--fs-h3);
    font-weight: 700;
    line-height: 1.2;
  }
  .hitme__p {
    margin-top: var(--sp-1);
    font-size: var(--fs-small);
    color: var(--ink-3);
  }
  .hitme__row {
    margin-top: var(--sp-4);
  }
</style>
