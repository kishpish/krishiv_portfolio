---
// The home page is previews only. Every section shows its top few items and
// then links to the page that holds the rest, so nothing here is the last word
// on anything. The one exception is the section about me, which is the only
// place the interests and the current work are stated in full.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import EnergyLandscape from '../components/EnergyLandscape.astro';
import PathDivider from '../components/PathDivider.astro';
import ResearchCard from '../components/ResearchCard.astro';
import PostCard from '../components/PostCard.astro';
import CVLink from '../components/CVLink.astro';
import Arguments from '../components/Arguments.astro';
import { data, clean } from '../lib/canonical';
import { url, absolute } from '../lib/urls';
import { allPosts } from '../lib/posts';

const p = data.person;
const projects = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
const topProjects = projects.slice(0, 3);
const posts = await allPosts();
const featuredPosts = [
  'energy-is-a-modeling-choice',
  'reward-is-a-bad-interface-for-design',
  'benchmarks-decide-what-a-field-discovers',
]
  .map((id) => posts.find((x) => x.id === id))
  .filter(Boolean) as typeof posts;

// Three, inline, with the full list on About.
const featuredHonors = data.honors.filter((h) => h.featured).slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: p.name,
  givenName: p.given_name,
  familyName: p.family_name,
  url: absolute('/'),
  email: `mailto:${p.email}`,
  description: clean(data.research_statement.short),
  knowsAbout: data.research_statement.interests,
  address: { '@type': 'PostalAddress', addressLocality: 'Austin', addressRegion: 'TX', addressCountry: 'US' },
  // The hero prints the affiliation as plain text now, but the structured data
  // still carries both institutional URLs.
  affiliation: {
    '@type': 'ResearchOrganization',
    name: `${p.affiliation.group}, ${p.affiliation.institute}`,
    url: p.affiliation.institute_url,
    sameAs: p.affiliation.group_url,
    parentOrganization: { '@type': 'CollegeOrUniversity', name: p.affiliation.university },
  },
  alumniOf: { '@type': 'EducationalOrganization', name: p.education.school },
  sameAs: [p.profiles.github, p.profiles.linkedin, p.profiles.orcid, p.profiles.scholar].filter(Boolean),
  identifier: { '@type': 'PropertyValue', propertyID: 'ORCID', value: p.profiles.orcid_id },
};
---

<Base description={clean(data.site.description)} og="default" type="profile" jsonLd={jsonLd}>
  <!-- ============================================ hero -->
  <section class="wrap hero" aria-labelledby="hero-name">
    <div class="hero__text">
      <h1 id="hero-name" class="hero__name">{p.name}</h1>
      <p class="hero__role">Student Researcher, Current @ Computational Visualization Center, UT Austin Oden Institute</p>

      <p class="hero__statement">
        I work at the intersection of machine learning, computational biology, and
        physics-based simulation.
      </p>
      <p class="hero__personal">
        I would rather be worse off for a while than stay where I happened to land.
      </p>

      <div class="hero__actions">
        <CVLink variant="button" />
        <a class="hero__action" href={`mailto:${p.email}`}>{p.email}</a>
      </div>
    </div>

    <div class="hero__fig">
      <EnergyLandscape
        mode="hero"
        caption={'The Müller-Brown potential: three basins, two saddles, and a dashed minimum-energy path between the two deepest wells. The orange trace is a particle finding the deepest one.'}
        captionMotion={'Here it keeps running, filling whichever basin it sits in until it can escape. Move the cursor across the surface to push on it.'}
      />
    </div>
  </section>

  <div class="wrap"><PathDivider at={1} mark="B" /></div>

  <!-- ============================================ currently -->
  <section class="wrap section" aria-labelledby="currently">
    <div class="section__head">
      <p class="eyebrow">Currently</p>
      <h2 id="currently">Research interests and current work</h2>
    </div>

    <div class="now">
      <div class="now__main">
        <ul class="now__list">
          <li>
            <strong>Antibody design as control.</strong> A port-Hamiltonian reinforcement
            learning model that generates antibodies by optimizing a path across an energy
            landscape rather than screening a library, at the
            <a href={p.affiliation.group_url} rel="noopener">{p.affiliation.group}</a>, advised by
            {' '}{p.affiliation.advisor}.
            <a href={url('/research/antibody-transition-paths/')}>The project page.</a>
          </li>
          <li>
            <strong>Circular RNA that translates reliably</strong>, as a durable therapy for the
            lab's Parkinson's disease work. Presented at the 2026 Summer Research Demo Day in the
            <a href="https://tacc.utexas.edu/" rel="noopener">TACC Visualization Lab</a>.
          </li>
          <li>
            <strong>Writing up</strong> the
            <a href={url('/research/aml-energy-landscape/')}>leukemia landscape</a> and the
            <a href={url('/research/expression-benchmark/')}>expression benchmark</a>, and arguing
            with both of them in <a href={url('/writing/')}>notes</a>.
          </li>
        </ul>

        <p class="now__honors">
          Recently:{' '}
          {
            featuredHonors.map((h, i) => (
              <>
                {i > 0 && ', '}
                {h.href ? <a href={h.href} rel="noopener">{h.title}</a> : h.title}
                {' '}<span class="tnum muted">{h.year}</span>
              </>
            ))
          }. <a href={url('/about/#honors')}>All honors, positions, and education are on About.</a>
        </p>
      </div>

      <aside class="now__side">
        <p class="eyebrow">Directions</p>
        <ul class="now__interests">
          {data.research_statement.interests.map((i) => <li>{i}</li>)}
        </ul>
      </aside>
    </div>
  </section>

  <div class="wrap"><PathDivider at={0.81} mark="‡" /></div>

  <!-- ============================================ research (preview) -->
  <section class="wrap section" aria-labelledby="research">
    <div class="section__head">
      <p class="eyebrow">Selected</p>
      <h2 id="research">Research</h2>
      <p>
        Three of five. Each one states the problem, the method, the result, and what did not
        work, with the paper and the code on the same page.
      </p>
    </div>
    <div class="rlist">
      {topProjects.map((entry, i) => <ResearchCard entry={entry} n={i + 1} compact />)}
    </div>
    <p class="section__more">
      <a href={url('/research/')}>All five projects, with the publication list</a>
    </p>
  </section>

  <div class="wrap"><PathDivider at={0.683} mark="C" /></div>

  <!-- ============================================ writing (preview) -->
  <section class="wrap section" aria-labelledby="writing">
    <div class="section__head">
      <p class="eyebrow">Notes</p>
      <h2 id="writing">Writing</h2>
      <p>Three of {posts.length}. No dates on any of them, and I edit them in place.</p>
    </div>
    <div class="plist">
      {featuredPosts.map((post) => <PostCard post={post} showSection />)}
    </div>
    <p class="section__more">
      <a href={url('/writing/')}>All {posts.length} notes, by subject</a>
    </p>
  </section>

  <div class="wrap"><PathDivider at={0.381} mark="‡" /></div>

  <Arguments />
</Base>

<style>
  /* ---------- hero */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.92fr);
    gap: var(--sp-7);
    align-items: start;
    padding-block: var(--sp-8) var(--sp-4);
  }
  .hero__name {
    font-size: var(--fs-name);
    font-weight: 400;
    letter-spacing: -0.022em;
    line-height: 1.02;
  }
  .hero__role {
    margin-top: var(--sp-3);
    font-size: calc(var(--fs-body) * 1.02);
    color: var(--ink-2);
    max-width: 38ch;
    text-wrap: pretty;
  }
  .hero__statement {
    margin-top: var(--sp-5);
    max-width: 44ch;
    text-wrap: pretty;
  }
  /* The personal line sits apart from the factual one above it, and next to the
     figure. Nothing explains the pairing. */
  .hero__personal {
    margin-top: var(--sp-4);
    max-width: 42ch;
    font-size: calc(var(--fs-body) * 1.08);
    line-height: 1.45;
    color: var(--ink);
    text-wrap: pretty;
  }
  .hero__actions {
    margin-top: var(--sp-5);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-3) var(--sp-5);
  }
  .hero__action {
    font-size: var(--fs-body);
  }
  .hero__fig {
    position: sticky;
    top: var(--sp-4);
  }

  @media (max-width: 54rem) {
    .hero {
      grid-template-columns: 1fr;
      gap: var(--sp-6);
      padding-block: var(--sp-6) var(--sp-2);
    }
    .hero__fig {
      position: static;
      max-width: 34rem;
    }
    .hero__role,
    .hero__statement,
    .hero__personal {
      max-width: var(--measure);
    }
  }

  /* ---------- currently */
  .now {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: var(--sp-6);
    align-items: start;
  }
  .now__list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--sp-4);
    max-width: var(--measure);
  }
  .now__list li {
    padding-left: var(--sp-4);
    border-left: 2px solid var(--blue-16);
    text-wrap: pretty;
  }
  .now__honors {
    margin-top: var(--sp-5);
    padding-top: var(--sp-4);
    border-top: 1px solid var(--rule);
    font-size: var(--fs-small);
    color: var(--ink-2);
    max-width: var(--measure);
    text-wrap: pretty;
  }
  .now__interests {
    margin-top: var(--sp-3);
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--sp-2);
    font-size: var(--fs-small);
  }
  .now__interests li {
    color: var(--ink-2);
    padding-left: 1.1em;
    position: relative;
    text-wrap: pretty;
  }
  .now__interests li::before {
    content: '·';
    position: absolute;
    left: 0.1em;
    color: var(--orange);
  }
  @media (max-width: 48rem) {
    .now {
      grid-template-columns: 1fr;
      gap: var(--sp-5);
    }
  }

  /* ---------- lists */
  .rlist,
  .plist {
    border-bottom: 1px solid var(--rule);
  }
  .section__more {
    margin-top: var(--sp-4);
    font-size: var(--fs-small);
  }

</style>
