---
// The Me page is one composition rather than a timeline. Two photographs and
// five bullet points is not a timeline, and the rest of what would have gone
// on one already lives on More, so repeating it here would only split it in
// two. What this page has that no other page has is the pitch, which is worth
// building the page around.
//
// All of the prose comes from canonical.yaml, so the page can be rewritten
// without opening this file.
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import PitchLab from '../components/PitchLab.astro';
import { data, clean } from '../lib/canonical';
import { url } from '../lib/urls';

const me = data.me_page;
const kid = data.images.portrait_child;
const park = data.images.ballpark;

// Both photographs are shown whole. The columns are sized by each one's own
// aspect ratio, which is what makes the two frames end up the same height
// without either of them being cropped to get there.
const photos = [
  { img: kid, ratio: kid.width / kid.height },
  { img: park, ratio: park.width / park.height },
];
---

<Base title="Me" description="Krishiv Potluri outside the lab: baseball, and the physics of a pitch." og="me" mascot="baseball">
  <div class="wrap me-page">
    <PageHeader eyebrow="Me" title="Baseball" lede={clean(me.lede)} />

    <div class="me-photos" data-reveal>
      {
        photos.map((ph) => (
          <figure class="me-photo" style={`--ratio:${ph.ratio.toFixed(4)}`}>
            <picture>
              <source srcset={url(`${ph.img.src}.webp`)} type="image/webp" />
              <img
                src={url(`${ph.img.src}.jpg`)}
                alt={clean(ph.img.alt)}
                width={ph.img.width}
                height={ph.img.height}
                loading="lazy"
                decoding="async"
              />
            </picture>
          </figure>
        ))
      }
      <p class="me-photos__cap">{clean(me.photo_caption)}</p>
    </div>

    {/* No heading above it: a heading would announce the subject, and announcing
        it is the opposite of saying it. */}
    <p class="me-team" data-reveal>{clean(me.baseball_life)}</p>

    {/* A toy, not a section of a paper. It is set in its own narrower block with
        a smaller heading and one line of setup, so the weight on the page
        matches what it is. The physics inside is untouched. */}
    <section class="me-demo" aria-labelledby="pitch" data-reveal>
      <h2 id="pitch" class="me-demo__h">{me.demo_heading}</h2>
      <p class="me-demo__p">{clean(me.pitch_intro)}</p>
      <PitchLab />
    </section>

    <p class="me-closing measure">
      {clean(me.closing)}{' '}
      <!-- "More" alone is not a description of where the link goes, so the rest
           of the sentence is carried for anyone who is listening to it. -->
      <a href={url('/about/')}>More<span class="visually-hidden">, the page with the rest of this</span></a>.
    </p>

    {/* A note about the page, not content on it. Quiet, small, mono, and set
        well apart from the copy above so it never reads as a heading or as
        something broken. */}
    <p class="me-wip" role="note">{me.wip}</p>
  </div>
</Base>

<style>
  .me-page {
    padding-bottom: var(--sp-9);
  }

  /* Two frames, neither cropped, ending the same height because each column is
     as wide as its own picture needs to be. */
  .me-photos {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
    align-items: flex-start;
  }
  .me-photo {
    flex: var(--ratio) 1 0;
    min-width: 12rem;
    margin: 0;
    border-radius: var(--card-radius);
    overflow: hidden;
    background: var(--paper);
    box-shadow: var(--shadow-1);
  }
  .me-photo img {
    display: block;
    width: 100%;
    height: auto;
  }
  .me-photos__cap {
    flex: 1 0 100%;
    font-size: var(--fs-small);
    color: var(--ink-4);
  }

  /* Set off from the photographs above by space rather than by a rule, so it
     reads as the same person still talking rather than as a new section. */
  .me-team {
    margin-top: var(--sp-7);
    max-width: var(--measure);
    color: var(--ink-2);
    text-wrap: pretty;
  }

  /* The demo sits in from the measure on both sides and carries its own quiet
     rule, so it reads as a self-contained thing dropped on the page rather than
     as the next section of an argument. */
  .me-demo {
    margin-top: var(--sp-8);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--rule);
    max-width: 56rem;
  }
  /* A step down from a section heading, because this is a caption for a toy. */
  .me-demo__h {
    font-size: calc(var(--fs-body) * 1.12);
    font-weight: 700;
    color: var(--ink-2);
  }
  .me-demo__p {
    margin-top: var(--sp-2);
    margin-bottom: var(--sp-5);
    max-width: var(--measure);
    font-size: var(--fs-small);
    line-height: 1.55;
    color: var(--ink-3);
    text-wrap: pretty;
  }
  .me-closing {
    margin-top: var(--sp-8);
    color: var(--ink-2);
  }
  .me-wip {
    margin-top: var(--sp-7);
    font-family: var(--mono);
    font-size: var(--fs-small);
    color: var(--ink-4);
  }

  @media (max-width: 34rem) {
    .me-photo {
      flex-basis: 100%;
    }
  }
</style>
