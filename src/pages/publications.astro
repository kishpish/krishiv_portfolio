---
// Publications merged into /research/, so a project and the paper it produced
// sit together. This page stays behind because the old address has been shared,
// and a shared link should not 404. It is noindex, so search engines follow the
// move rather than keeping both.
import Base from '../layouts/Base.astro';
import { url } from '../lib/urls';

const to = url('/research/#papers-h');
---

<Base
  title="Publications have moved"
  description="The publication list now sits on the research page, with each paper next to the project it came from."
  og="publications"
  noindex
>
  <meta http-equiv="refresh" content={`0; url=${to}`} slot="head" />
  <div class="wrap moved">
    <p class="eyebrow">Moved</p>
    <h1>Publications are on the research page</h1>
    <p class="moved__lede">
      Splitting a project from the paper it produced meant a reader who wanted the preprint
      landed somewhere other than the description. They are together now, with the formal
      citation list below the projects.
    </p>
    <p class="moved__go"><a href={to}>Go to the publication list</a></p>
  </div>
</Base>

<style>
  .moved {
    padding-block: var(--sp-8) var(--sp-8);
    max-width: var(--measure);
  }
  .moved__lede {
    margin-top: var(--sp-4);
    color: var(--ink-2);
  }
  .moved__go {
    margin-top: var(--sp-5);
  }
</style>
