---
// Research and publications, one page. Splitting a project from the paper it
// produced sent a reader looking for the TEM-171 preprint to a different
// address from the TEM-171 description, so the projects lead and each carries
// its own publication metadata. The formal citation list sits below them,
// because that is what an academic reader scrolls to and it should be
// copyable. Talks and media are at the foot.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import ResearchCard from '../../components/ResearchCard.astro';
import PubList from '../../components/PubList.astro';
import CVLink from '../../components/CVLink.astro';
import PageLandscape from '../../components/PageLandscape.astro';
import { data, clean, statusLabel } from '../../lib/canonical';
import { url, absolute } from '../../lib/urls';

const projects = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
const description =
  'Five research projects in machine learning for biology and physics-based simulation, each with its paper, preprint, and code: antibody design as transition-path control, an energy landscape of leukemic cell states, de novo protein inhibitors, patient-specific cardiac biomaterials, and a leakage-audited expression benchmark.';

// The publication records now live at /research/#<id>, so the structured data
// points there rather than at the retired /publications/ address.
const jsonLd = data.publications.map((pub) => ({
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline: clean(pub.title),
  name: clean(pub.title),
  author: pub.authors.map((name) => ({ '@type': 'Person', name })),
  datePublished: String(pub.year),
  publication: pub.venue_long,
  creativeWorkStatus: statusLabel[pub.status],
  ...(pub.doi ? { identifier: `https://doi.org/${pub.doi}`, sameAs: `https://doi.org/${pub.doi}` } : {}),
  url: absolute('/research/') + `#${pub.id}`,
}));
---

<Base title="Research" description={description} og="research" jsonLd={jsonLd}>
  <div class="wrap">
    <PageHeader
      eyebrow="Research"
      title="Research"
      lede="Five projects. Each page states the problem, the method, the result, and what did not work. Papers, preprints, and code are linked from the project they came from, and the formal list is at the foot of this page."
    >
      <div class="rhead__aside">
        <CVLink variant="button" />
        <p class="rhead__note">
          Everything here is first author. Venue and status are stated exactly as they stand.
        </p>
      </div>
    </PageHeader>

    <PageLandscape view="surface" n="0.1" class="rhead__fig" />

    <section class="rlist" aria-label="Projects">
      {projects.map((entry, i) => <ResearchCard entry={entry} n={i + 1} level={2} />)}
    </section>

    <section class="pubsec" aria-labelledby="papers-h">
      <p class="eyebrow">Formal list</p>
      <h2 id="papers-h">Publications</h2>
      <p class="pubsec__note">
        The same papers as above, in citation form, so a line can be copied straight out.
      </p>
      <PubList />
    </section>

    <section class="pubsec" aria-labelledby="talks-h">
      <p class="eyebrow">Presented</p>
      <h2 id="talks-h">Talks and posters</h2>
      <ol class="simple">
        {
          data.talks.map((t) => (
            <li>
              <p class="simple__t">
                {t.href ? <a href={t.href} rel="noopener">{t.title}</a> : t.title}
              </p>
              <p class="simple__m meta">
                <span>{t.venue}</span>
                <span class="num">{t.year}</span>
                <span>{t.kind}</span>
              </p>
              {t.note && <p class="simple__n">{t.note}</p>}
            </li>
          ))
        }
      </ol>
    </section>

    <section class="pubsec pubsec--last" aria-labelledby="media-h">
      <p class="eyebrow">Written about</p>
      <h2 id="media-h">Media</h2>
      <ol class="simple">
        {
          data.media.map((m) => (
            <li>
              <p class="simple__t">
                <a href={m.href} rel="noopener">{m.title}</a>
              </p>
              <p class="simple__m meta">
                <span>{m.outlet}</span>
                <span class="num">{m.year}</span>
              </p>
            </li>
          ))
        }
      </ol>
      <p class="rfoot">
        <a href={url('/about/')}>Honors, positions, and identifiers are on About</a>
      </p>
    </section>
  </div>
</Base>

<style>
  .rhead__aside {
    margin-top: var(--sp-5);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-3) var(--sp-5);
  }
  .rhead__note {
    font-size: var(--fs-small);
    color: var(--ink-3);
    max-width: 48ch;
    flex: 1 1 22rem;
  }
  .rhead__fig {
    margin-block: var(--sp-7) var(--sp-6);
  }
  .rlist {
    border-bottom: 1px solid var(--rule);
  }
  .pubsec {
    padding-top: var(--sp-8);
  }
  .pubsec h2 {
    margin-bottom: var(--sp-3);
  }
  .pubsec__note {
    margin-bottom: var(--sp-5);
    font-size: var(--fs-small);
    color: var(--ink-3);
    max-width: var(--measure);
  }
  .pubsec--last {
    padding-bottom: var(--sp-6);
  }
  .simple {
    list-style: none;
    padding: 0;
    max-width: var(--measure);
  }
  .simple li {
    padding-block: var(--sp-4);
    border-top: 1px solid var(--rule);
  }
  .simple li:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .simple__t {
    font-weight: 700;
    line-height: 1.35;
    text-wrap: pretty;
  }
  .simple__t a {
    color: var(--ink);
  }
  .simple__t a:hover,
  .simple__t a:focus-visible {
    color: var(--orange);
  }
  .simple__m {
    margin-top: var(--sp-2);
  }
  .simple__n {
    margin-top: var(--sp-1);
    font-size: var(--fs-small);
    font-style: italic;
    color: var(--ink-3);
  }
  .rfoot {
    margin-top: var(--sp-5);
    font-size: var(--fs-small);
  }
</style>
