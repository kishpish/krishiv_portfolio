---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Toc from '../../components/Toc.astro';
import { data, sentence } from '../../lib/canonical';
import { url, absolute } from '../../lib/urls';
import { allPosts, neighbours, readingMinutes, tagSlug, sectionSlug } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getCollection('posts', (p) => !p.data.draft);
  return posts.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content, headings } = await render(entry);
const minutes = readingMinutes(entry.body);
const { prev, next } = await neighbours(entry.id);
const sectionMeta = data.writing.sections.find((s) => s.name === d.section);

// Cross-links: whatever the post declares, plus anything sharing two tags.
const posts = await allPosts();
const declared = (d.related ?? []).map((id) => posts.find((p) => p.id === id)).filter(Boolean) as typeof posts;
const byTag = posts.filter(
  (p) =>
    p.id !== entry.id &&
    !declared.some((x) => x.id === p.id) &&
    p.data.tags.filter((t) => d.tags.includes(t)).length >= 2,
);
const related = [...declared, ...byTag].slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: d.title,
  description: d.description,
  author: { '@type': 'Person', name: data.person.name, url: absolute('/') },
  url: absolute(`/writing/${entry.id}/`),
  keywords: d.tags.join(', '),
  articleSection: d.section,
  isAccessibleForFree: true,
  image: absolute(`/og/writing-${entry.id}.png`),
};
// Math is rendered at build time; this stylesheet is only loaded on the pages
// that can contain it.
import 'katex/dist/katex.min.css';
---

<Base
  title={d.title}
  description={d.description}
  og={`writing-${entry.id}`}
  type="article"
  jsonLd={jsonLd}
>
  <div class="wrap post">
    <aside class="post__side">
      <div class="post__sticky">
        <Toc headings={headings} />
      </div>
    </aside>

    <article class="post__main">
      <header class="post__head">
        <p class="eyebrow">
          <a href={url('/writing/')}>Writing</a> /{' '}
          <a href={url(`/writing/#sec-${sectionMeta?.slug ?? sectionSlug(d.section)}`)}>{d.section}</a>
        </p>
        <h1>{d.title}</h1>
        <p class="post__desc">{d.description}</p>
        <p class="post__meta meta">
          <span class:list={['badge', d.status === 'in progress' ? 'badge--in-progress' : 'badge--note']}>
            {sentence(d.status)}
          </span>
          <span>{minutes} min</span>
          <span class="post__tags">
            {
              d.tags.map((t, i) => (
                <>
                  {i > 0 && <span class="post__comma">, </span>}
                  <a href={url(`/writing/tags/${tagSlug(t)}/`)}>{t}</a>
                </>
              ))
            }
          </span>
        </p>
        {
          d.status === 'in progress' && (
            <p class="post__wip">
              This one is unfinished. It is up because a rough note with a label on it is more
              useful than a polished one that never gets published.
            </p>
          )
        }
      </header>

      <div class="prose post__body">
        <Content />
      </div>

      <footer class="post__foot">
        <p class="post__edited">
          Notes get edited in place. If something here is wrong, I would like to know:{' '}
          <a href={`mailto:${data.person.email}?subject=${encodeURIComponent(d.title)}`}>{data.person.email}</a>
        </p>

        {
          related.length > 0 && (
            <section class="post__related" aria-labelledby="related">
              <p class="eyebrow" id="related">related</p>
              <ul>
                {related.map((p) => (
                  <li>
                    <a href={url(`/writing/${p.id}/`)}>{p.data.title}</a>
                    <span class="post__rel-desc">{p.data.description}</span>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <nav class="postnav" aria-label="Other notes">
          {
            prev ? (
              <a class="postnav__link" href={url(`/writing/${prev.id}/`)}>
                <span class="postnav__dir">← previous</span>
                <span class="postnav__t">{prev.data.title}</span>
              </a>
            ) : (
              <span />
            )
          }
          {
            next ? (
              <a class="postnav__link postnav__link--next" href={url(`/writing/${next.id}/`)}>
                <span class="postnav__dir">next →</span>
                <span class="postnav__t">{next.data.title}</span>
              </a>
            ) : (
              <span />
            )
          }
        </nav>
      </footer>
    </article>

  </div>
</Base>

<style>
  .post {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 14rem;
    gap: var(--sp-7);
    align-items: start;
    padding-block: var(--sp-7) var(--sp-6);
  }
  /* The contents come first in the DOM so keyboard focus meets them where they
     appear. On a wide screen they are placed into the right-hand column. */
  .post__main {
    min-width: 0;
    grid-column: 1;
    grid-row: 1;
  }
  .post__side {
    grid-column: 2;
    grid-row: 1;
  }
  .post__head {
    max-width: var(--measure);
    padding-bottom: var(--sp-5);
    border-bottom: 1px solid var(--rule);
  }
  .post__head h1 {
    text-wrap: balance;
  }
  .post__desc {
    margin-top: var(--sp-3);
    font-size: calc(var(--fs-body) * 1.06);
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .post__meta {
    margin-top: var(--sp-4);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
  }
  .post__tags a {
    color: var(--ink-3);
  }
  .post__tags a:hover,
  .post__tags a:focus-visible {
    color: var(--orange);
  }
  .post__comma {
    color: var(--ink-4);
  }
  .post__wip {
    margin-top: var(--sp-4);
    padding: var(--sp-3) var(--sp-4);
    border-left: 2px dashed var(--orange);
    background: var(--paper-2);
    font-size: var(--fs-small);
    color: var(--ink-2);
  }
  .post__body {
    padding-top: var(--sp-5);
  }

  .post__side {
    position: sticky;
    top: var(--sp-5);
    padding-top: var(--sp-7);
  }

  .post__foot {
    margin-top: var(--sp-7);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--rule);
    max-width: var(--measure);
  }
  .post__edited {
    font-size: var(--fs-small);
    color: var(--ink-3);
  }
  .post__related {
    margin-top: var(--sp-6);
  }
  .post__related ul {
    list-style: none;
    padding: 0;
    margin-top: var(--sp-3);
    display: grid;
    gap: var(--sp-3);
  }
  .post__related li {
    display: grid;
    gap: 0.15em;
  }
  .post__rel-desc {
    font-size: var(--fs-small);
    color: var(--ink-3);
    text-wrap: pretty;
  }
  .postnav {
    margin-top: var(--sp-6);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--rule);
    display: flex;
    justify-content: space-between;
    gap: var(--sp-5);
  }
  .postnav__link {
    display: grid;
    gap: 0.15em;
    max-width: 17rem;
  }
  .postnav__link--next {
    text-align: right;
  }
  .postnav__dir {
    font-size: var(--fs-tiny);
    color: var(--ink-4);
  }
  .postnav__t {
    font-weight: 700;
    line-height: 1.3;
    text-wrap: pretty;
  }

  @media (max-width: 60rem) {
    .post {
      grid-template-columns: 1fr;
      gap: var(--sp-4);
    }
    .post__side {
      position: static;
      grid-column: 1;
      grid-row: auto;
      padding-top: 0;
      max-width: var(--measure);
      border-bottom: 1px solid var(--rule);
      padding-bottom: var(--sp-4);
    }
    .post__main {
      grid-row: auto;
    }
  }
</style>
